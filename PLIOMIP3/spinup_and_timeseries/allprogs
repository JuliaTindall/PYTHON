def get_salinity_band(year):
    """
    gets the salinity at each of the bands
    #   a) surface
    #   b) top 100m
    #   c) top 200m
    #   d) top 1000m
    #   e) 1000m-3000m

    """
 
    filename=(filestart+'/basin_diagnostics/'+exptname+'_Pacific'+
              str(year) +'.nc')
    print(filename)
    cubes = iris.load(filename)
    # extract 3d salinity
    salincube = cubes.extract('salinity basin')[0]
    # salinity southwards of 65S
    south_constraint = iris.Constraint(latitude=lambda v:v<latmax)
    salin_south_cube =salincube.extract(south_constraint)

    # average over area
    lat = salin_south_cube.coord('latitude')
    lon = salin_south_cube.coord('longitude')
    depth = salin_south_cube.coord('depth_1')
    if not lat.has_bounds():
        lat.guess_bounds()
    if not lon.has_bounds():
        lon.guess_bounds()
    if not depth.has_bounds():
        depth.guess_bounds()


    weights = iris.analysis.cartography.area_weights(salin_south_cube)

    # mean by depth
    salin_levels_cube = salin_south_cube.collapsed(['latitude','longitude'],
                                                 iris.analysis.MEAN,
                                                 weights=weights)

    surf_data = salin_levels_cube[0].data

    # extract cube by levels
    cube_100 = salin_levels_cube.extract(iris.Constraint(depth_1=lambda d:d<100))
    cube_200 = salin_levels_cube.extract(iris.Constraint(depth_1=lambda d:d<200))
    cube_1000 = salin_levels_cube.extract(
        iris.Constraint(depth_1=lambda d:d<1000))
    cube_1000_3000 = salin_levels_cube[13:16]
    
    
    thickness = np.diff(depth.bounds,axis=1).squeeze()
    
    avg_100=cube_100.collapsed('depth_1',iris.analysis.MEAN,
                               weights=thickness[0:len(cube_100.data)])
    avg_200=cube_200.collapsed('depth_1',iris.analysis.MEAN,
                               weights=thickness[0:len(cube_200.data)])
    avg_1000=cube_1000.collapsed('depth_1',iris.analysis.MEAN,
