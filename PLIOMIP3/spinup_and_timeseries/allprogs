def get_temperature_band(year):
    """
    gets the temperature at each of the bands
    #   a) surface
    #   b) top 100m
    #   c) top 200m
    #   d) top 1000m
    #   e) 1000m-3000m

    """
 
    filename=(filestart+'/basin_diagnostics/'+exptname+'_Pacific'+
              str(year) +'.nc')
    print(filename)
    cubes = iris.load(filename)
    # extract 3d temperature
    tempcube = cubes.extract('temperature basin')[0]
    # temperature southwards of 65S
    south_constraint = iris.Constraint(latitude=lambda v:v<latmax)
    temp_south_cube =tempcube.extract(south_constraint)

    # average over area
    lat = temp_south_cube.coord('latitude')
    lon = temp_south_cube.coord('longitude')
    depth = temp_south_cube.coord('depth_1')
    if not lat.has_bounds():
        lat.guess_bounds()
    if not lon.has_bounds():
        lon.guess_bounds()
    if not depth.has_bounds():
        depth.guess_bounds()


    weights = iris.analysis.cartography.area_weights(temp_south_cube)

    # mean by depth
    temp_levels_cube = temp_south_cube.collapsed(['latitude','longitude'],
                                                 iris.analysis.MEAN,
                                                 weights=weights)

    surf_data = temp_levels_cube[0].data

    # extract cube by levels
    cube_100 = temp_levels_cube.extract(iris.Constraint(depth_1=lambda d:d<100))
    cube_200 = temp_levels_cube.extract(iris.Constraint(depth_1=lambda d:d<200))
