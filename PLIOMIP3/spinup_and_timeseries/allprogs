    plt.tight_layout()


    fileout=('/nfs/hera1/earjcti/um/' + exptname + '/spinup/tdrift_'+exptname+'_' + levels_plotted + '.eps') 
    plt.savefig(fileout, bbox_inches='tight')  
    
    plt.close()


