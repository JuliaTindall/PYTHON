def get_cmap(boundaries, mean):
    # Shift boundaries by mean
    b = np.array(boundaries)

    # Normalised positions (0 → 1) for each boundary
    t = np.linspace(0, 1, len(b))

    # Find the normalised positions of 0 and mean
    pos0 = np.interp(0, b, t)      # blue → grey transition
    posM = np.interp(mean, b, t)   # grey → red transition

    # Base colormaps
    blues = plt.cm.Blues(np.linspace(0.2, 1, 128))
    rdgy  = plt.cm.RdGy_r(np.linspace(0, 1, 256))

    # Extract grey and red regions from RdGy_r
    grey_region = rdgy[:128]   # lower half = greys
    red_region  = rdgy[128:]   # upper half = reds

    # Build a 3‑segment gradient colormap
    colors = [
        (0.0, blues[0]),         # start blue
        (pos0, blues[-1]),       # end blue at x=0
        (pos0, grey_region[0]),  # start grey
        (posM, grey_region[-1]), # end grey at x=mean
        (posM, red_region[0]),   # start red
        (1.0, red_region[-1])    # end red
    ]

    return LinearSegmentedColormap.from_list("custom", colors)

    
