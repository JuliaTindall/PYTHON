    depdiff[0]=depths[1]-depths[0]
    depdiff[19]=depths[19]-depths[18]
    onedeg=111100.   # 111.3 km
    
    northheat_flux = np.zeros(20) # calculate the amount of heat exchanged

                    
            
  
    
    for j, lat in enumerate(lats):
        if lat in vacross:
            ix = vacross.index(lat)
            coslat = np.cos(lat * 2.0 * np.pi / 360.) 
            for i,lon in enumerate(lons):
                if lonmin[ix] < lon < lonmax[ix]:
                    for k,dep in enumerate(depths):
                        if not Vcube.data.mask[0,k,j,i]:
                            # add on the northward flux for all depths
                            flux_add = ((Vcube.data[0,k,j,i] *
                                         Tcube.data[0,k,j,i])
                                        * depdiff[k]
                                        * coslat * onedeg * (lons[1]-lons[0]))
                            northheat_flux[k] = northheat_flux[k] + flux_add

                            
    eastheat_flux=np.zeros(20) # this is U x T Xarea
    for i, lon in enumerate(lons):
        if lon in uacross:
            ix=uacross.index(lon)
            for j,lat in enumerate(lats):
                if latmin[ix] < lat < latmax[ix]:
                    for k,dep in enumerate(depths):
                        if not Ucube.data.mask[0,k,j,i]:
                            # add on the eastward flux for all depths
                            flux_add = ((Ucube.data[0,k,j,i] *
                                         Tcube.data[0,k,j,i]) 
                                        * depdiff[k]
                                        * onedeg * (lats[1]-lats[0]))
                            eastheat_flux[k] = eastheat_flux[k] + flux_add

    northOHT=np.sum(northheat_flux) * density * cp / 1.0E15
    eastOHT=np.sum(eastheat_flux) * density * cp / 1.0E15

    print(northOHT,eastOHT,northOHT+eastOHT)
 
    return northOHT,eastOHT,vacross[0]

  


