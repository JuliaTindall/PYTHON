    if basin =='atlantic':  # basin must be global / atlantic / pacific
        ax.set_title('a) Atlantic Ocean Heat Transport',fontsize=16)
        ax.set_ylim(-30,90)
        ax.set_yticks([-30, 0, 30, 60, 90])
