    sys.exit()
    plt.savefig('OHT/'+basin+'OHT_mean_' + str(yearstart) + '_' + str(yearend) + '.png')
    plt.close()

    #plt.subplot(111)
    #plt.plot(diffcube.data)
    #plt.show()
