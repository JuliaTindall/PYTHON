def run_mean(y):
    window = 30
    # convolution with a uniform window
    y_smooth = np.convolve(y, np.ones(window)/window, mode='valid')
    # put into an array the same size as y
    left = window //2
    right = window -1 -left

    yout = np.full_like(y,np.nan,dtype=float)
    yout[left:len(y)-right]=y_smooth
 
